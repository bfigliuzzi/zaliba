{
  "name": "zaliba",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zany Alien Battles — jeu web de stratégie spatiale, sans pay2win",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "turbo run build",
    "test": "vitest run --project catalogs --project domain --project contracts --project db --project api --project game",
    "test:integration": "vitest run --project api-integration",
    "test:coverage": "vitest run --project domain --coverage",
    "dev": "turbo run dev",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
