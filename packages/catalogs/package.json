{
  "name": "@zaliba/catalogs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Contenu de jeu déclaratif et typé. N'importe rien : c'est la feuille du graphe.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
