{
  "$description": "Zaliba — La Régie approximative. Tokens bruts, pour tout consommateur non-UnoCSS (Tailwind, CSS custom properties, Style Dictionary, SwiftUI…). Les ratios de contraste sont mesurés, pas estimés.",
  "couleur": {
    "encre":          { "valeur": "#1B2220", "role": "texte, liserés, glyphes", "contraste_sur_papier": 12.8 },
    "encre-nuit":     { "valeur": "#141A18", "role": "fond du thème sombre" },
    "encre-douce":    { "valeur": "#2A3230", "role": "case libre, thème sombre" },
    "ardoise":        { "valeur": "#4A5450", "role": "séparateur sur encre" },
    "mine":           { "valeur": "#96A09B", "role": "texte secondaire sur encre uniquement", "contraste_sur_encre": 6.16 },
    "trait":          { "valeur": "#6E7873", "role": "liseré minimal d'un composant sur papier", "contraste_sur_papier": 3.1 },
    "papier":         { "valeur": "#E2E6DC", "role": "fond de plaque, support de tout chiffre" },
    "pupitre":        { "valeur": "#D6DBD0", "role": "fond d'écran, case libre" },
    "carton":         { "valeur": "#C9CEC2", "role": "fond plateau" },
    "camelote":       { "valeur": "#C4552A", "role": "aplat et liseré, jamais du texte", "contraste_sur_encre": 3.5 },
    "camelote-brique":{ "valeur": "#8E3B1B", "role": "variante échelle de valeurs" },
    "jus":            { "valeur": "#E8B21C", "role": "remplissage seul, toujours bordé d'encre", "contraste_sur_encre": 1.5 },
    "bave":           { "valeur": "#8E4BA8", "role": "aplat", "contraste_sur_papier": 4.5 },
    "bave-nuit":      { "valeur": "#B072C8", "role": "teinte recalculée, thème sombre" },
    "bave-claire":    { "valeur": "#9C63B4", "role": "variante échelle de valeurs" }
  },
  "police": {
    "pochoir": { "famille": "Saira Stencil One", "graisses": [400], "usage": "nom de planète, gros boutons, tampons. Jamais porteur d'information seule." },
    "ui":      { "famille": "Archivo", "graisses": [400, 500, 600, 700, 800], "usage": "interface" },
    "etroit":  { "famille": "Archivo Narrow", "graisses": [400, 600, 700, 800], "usage": "niveaux dans les cases, titres serrés" },
    "mono":    { "famille": "JetBrains Mono", "graisses": [400, 500, 700], "usage": "tout chiffre. font-variant-numeric: tabular-nums OBLIGATOIRE — un compteur ne doit jamais frémir." }
  },
  "typo": {
    "micro":      { "taille": "8.5px", "interligne": 1.2,  "graisse": 600, "interlettre": ".16em", "casse": "uppercase" },
    "note":       { "taille": "9.5px", "interligne": 1.4,  "graisse": 400 },
    "label":      { "taille": "10px",  "interligne": 1.2,  "graisse": 700, "interlettre": ".16em", "casse": "uppercase" },
    "menu":       { "taille": "11.5px","interligne": 1.35, "graisse": 400 },
    "corps":      { "taille": "12px",  "interligne": 1.5,  "graisse": 400 },
    "item":       { "taille": "13px",  "interligne": 1.2,  "graisse": 600 },
    "fiche":      { "taille": "17px",  "interligne": 1.2,  "graisse": 700 },
    "chiffre-s":  { "taille": "16px",  "interligne": 1.05, "graisse": 700, "police": "mono" },
    "chiffre-m":  { "taille": "22px",  "interligne": 1.05, "graisse": 700, "police": "mono" },
    "chiffre-l":  { "taille": "30px",  "interligne": 1,    "graisse": 700, "police": "mono" },
    "pochoir-s":  { "taille": "19px",  "interligne": 1,    "police": "pochoir" },
    "pochoir-m":  { "taille": "24px",  "interligne": 1,    "police": "pochoir" },
    "titre-m":    { "taille": "34px",  "interligne": 0.95, "police": "pochoir" },
    "titre-l":    { "taille": "46px",  "interligne": 0.95, "police": "pochoir" }
  },
  "espacement": { "ras": "3px", "fin": "5px", "court": "7px", "moyen": "9px", "ample": "11px", "aise": "13px", "large": "16px", "guichet": "18px", "comptoir": "20px" },
  "trait": { "fin": "1.5px", "normal": "2px", "fort": "2.5px", "cadre": "3px" },
  "ombre": {
    "tampon": "5px 5px 0 #1B2220",
    "tampon-lg": "6px 6px 0 #1B2220",
    "tampon-doux": "4px 4px 0 rgba(27,34,32,.35)",
    "pupitre": "0 6px 0 #96A09B",
    "pupitre-sm": "0 4px 0 #4A5450",
    "batiment": "inset 0 0 0 3px #1B2220",
    "visee": "inset 0 0 0 5px #1B2220",
    "visee-nuit": "inset 0 0 0 5px #E8B21C",
    "$note": "Aucune ombre floue, jamais. Le décalage dur est de la matière, pas de la profondeur."
  },
  "arrondi": { "aucun": "0", "jeton": "9999px", "$note": "Le design n'a aucun arrondi sauf jetons et cadrans." },
  "rotation": { "plafond": "1.5deg", "rature": "-1.1deg", "etiquette": "-.6deg", "etiquette-inverse": ".5deg", "tampon": "-5deg", "$note": "Jamais sur un bloc de texte long. Jamais au focus. Jamais animée." },
  "cible_tactile": { "minimum": "44px", "effectif": "48px" },
  "glyphes": {
    "$viewBox": "0 0 24 24",
    "$regle": "fill=\"currentColor\" obligatoire — c'est ce qui fait survivre la silhouette au mode contrastes forcés.",
    "camelote": ["<polygon points=\"12,3 21,19.5 3,19.5\"/>", "<rect x=\"2.5\" y=\"20.5\" width=\"19\" height=\"2.4\"/>"],
    "jus": ["<polygon points=\"12,2 21.5,12 12,22 2.5,12\"/>", "<rect x=\"10.7\" y=\"6.5\" width=\"2.6\" height=\"11\" fill=\"[teinte du fond]\"/>"],
    "bave": ["<circle cx=\"12\" cy=\"12\" r=\"10\"/>", "<circle cx=\"12\" cy=\"12\" r=\"4\" fill=\"[teinte du fond]\"/>"],
    "chantier": ["<path d=\"M5 3 H19 L13 12 L19 21 H5 L11 12 Z\"/>"],
    "relief": ["<polygon points=\"12,4 22,20 2,20\"/>"],
    "pose_valide": ["<path d=\"M12 3 V21 M3 12 H21\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4\"/>"],
    "refus": ["<circle cx=\"12\" cy=\"12\" r=\"10.5\"/>", "<path d=\"M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5\" fill=\"none\" stroke=\"[papier]\" stroke-width=\"3\"/>"]
  }
}
